# Исключаем папку с тяжелыми бинарниками ffmpeg (программа скачает их сама)
bin/

# Исключаем временный мусор, который Python создает при запуске кода
__pycache__/
*.pyc

# Исключаем виртуальное окружение (если будешь его создавать)
venv/
.venv/

# Исключаем папки, которые создаст сборщик инсталляторов (PyInstaller)
build/
dist/
*.spec
